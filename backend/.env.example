# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

NODE_ENV=dev
PORT=4040
SITE_NAME=Crypto Info

# MongoDB
DB_URL=mongodb://127.0.0.1:27017/crypto-info

# Use a long, random secret in production
JWT_SECRET=replace-with-a-long-random-secret
JWT_VALIDITY=30d
JWT_VALIDITY_SHORT=1d

WEB_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
BACKEND_PUBLIC_URL=http://localhost:3000


# Futures only
COINDCX_FUTURES_MARGIN_CURRENCY=USDT

# Leave empty to scan ALL active futures pairs for the margin currency.
# Set a comma list only if you want to restrict pairs.
COINDCX_FUTURES_PAIRS=
# Only when PAIRS is empty: 0 = no cap (all pairs), e.g. 40 = first 40
COINDCX_MAX_INSTRUMENTS=0

COINDCX_SCANNER_ENABLED=true
# Book-aligned default: 1d. Also supports 4h and 1m.
COINDCX_SCANNER_TIMEFRAME=1d
# Optional raw CoinDCX resolution override (e.g. 240, 1D)
COINDCX_RESOLUTION_OVERRIDE=

# Refresh the available futures instrument list every 60 minutes
COINDCX_ACTIVE_MARKETS_REFRESH_MINUTES=60

# Leave empty to use timeframe default cron:
#   1d → 5 0 0 * * *   (00:00:05 UTC daily)
#   4h → 5 0 0,4,8,12,16,20 * * *
#   1m → 5 * * * * *
COINDCX_CRON_SCHEDULE=
# Use higher concurrency (10–20) when scanning all pairs on 1m
COINDCX_POLL_CONCURRENCY=15
COINDCX_POLL_LOOKBACK_CANDLES=3

# Historical candles used to seed ATR / volume / trend SMA
COINDCX_HISTORY_CANDLE_COUNT=120


# ─────────────────────────────────────────────
# Candle Detection
# ─────────────────────────────────────────────

# true = wait for the third bearish confirmation candle
CANDLE_REQUIRE_CONFIRMATION=true

# Minimum C1 body relative to its complete high-low range
CANDLE_MIN_IMPULSE_BODY_PERCENT=0.55

# Minimum C1 body relative to ATR(14)
CANDLE_MIN_ATR_MULTIPLIER=0.60

# C1 volume must be at least 1.2 times its 20-candle average
CANDLE_MIN_VOLUME_MULTIPLIER=1.20

# C2 body can be no larger than 50% of C1 body
CANDLE_MAX_INNER_BODY_RATIO=0.50

# Allowed containment tolerance relative to C1 body
CANDLE_BODY_TOLERANCE_PERCENT=0.05

# Comma-separated alert patterns (default preserves historical behavior)
CANDLE_ENABLED_PATTERNS=Bullish Engulfing,Bearish Engulfing,Evening Star,Morning Star,Three Inside Down,Three Inside Up

# Trade side filter: long | short | both (empty = both)
TRADE_SIDE_MODE=long

# Opt-in layered engine: geometry → context → confirmation → score
CANDLE_USE_ANALYSIS_ENGINE=true

# When using the analysis engine, require trend context to match pattern
CANDLE_REQUIRE_CONTEXT_MATCH=true

# Minimum evidence score [0..1] before an engine alert is persisted
CANDLE_MIN_CONFIDENCE=0.55

# High-conviction filter (drops average / weak setups)
CANDLE_HIGH_QUALITY_ONLY=true
CANDLE_PREMIUM_PATTERNS_ONLY=true
CANDLE_MIN_CONFIRMATION_STRENGTH=0.33
CANDLE_MIN_PATTERN_CANDLES=2

# Analytical trade plan sized for your futures wallet
TRADE_ACCOUNT_CURRENCY=INR
TRADE_ACCOUNT_BALANCE=2000
TRADE_RISK_PERCENT=1
TRADE_TP1_R=1.5
TRADE_TP2_R=2.5
TRADE_TP3_R=4
TRADE_MAX_LEVERAGE_CAP=5
TRADE_LEVERAGE_SAFETY_FACTOR=0.35
TRADE_MAX_MARGIN_FRACTION=0.40
TRADE_ATR_STOP_BUFFER_MULT=0.1
TRADE_USDT_INR_RATE=90

# Auto trading — keep dry-run until verified
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
# futures | spot — scanner stays on futures candles; spot maps B-BTC_USDT → BTCINR
AUTO_TRADE_MARKET=futures
AUTO_TRADE_SPOT_QUOTE=INR
AUTO_TRADE_MIN_QUANTITY=0.0001
AUTO_TRADE_QUANTITY_DECIMALS=4


# ─────────────────────────────────────────────
# SMTP Email Alerts
# ─────────────────────────────────────────────

CANDLE_ALERT_EMAIL_TO=receiver@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD=google-app-password
SMTP_FROM=sender@gmail.com


# ─────────────────────────────────────────────
# User Sessions and Trusted Devices
# ─────────────────────────────────────────────

TRUSTED_DEVICE_SESSION_DAYS=30
OTP_INACTIVITY_DAYS=30
TRUSTED_DEVICE_MAX_COUNT=10
MAX_USER_SESSIONS=20


# ─────────────────────────────────────────────
# HTTP Rate Limits
# ─────────────────────────────────────────────

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=500
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=1000
